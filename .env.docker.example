# Docker Compose Environment Variables
# Copy file ini ke .env dan sesuaikan untuk production

# MySQL Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=healthcare_db
MYSQL_USER=myuser
MYSQL_PASSWORD=change_this_password
MYSQL_PORT=3306

# Redis Configuration
REDIS_PORT=6379

# Application Configuration
PORT=3000
JWT_SECRET=change_this_to_very_strong_random_secret
JWT_EXPIRATION=15m
